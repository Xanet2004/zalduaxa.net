SPRING_PROFILES_ACTIVE=dev

# JWT
APP_JWT_SECRET=change-me-dev-jwt-secret-at-least-32-characters
APP_JWT_EXPIRATION_MS=86400000

# Database for local non-Docker runs
DB_URL=jdbc:postgresql://localhost:5432/zalduaxa_net_dev
DB_USERNAME=app
DB_PASSWORD=app

# PostgreSQL container password
POSTGRES_PASSWORD=app

# Storage
STORAGE_PATH=file:/app/storage/

# CORS
APP_CORS_ORIGIN=http://localhost:5173

# Auth cookie
APP_AUTH_COOKIE_NAME=token
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_HTTPONLY=false
APP_AUTH_COOKIE_SAMESITE=Lax
APP_AUTH_COOKIE_DOMAIN=
APP_AUTH_COOKIE_PATH=/
APP_AUTH_COOKIE_MAX_AGE_DAYS=1

# Password pepper
APP_PASSWORD_PEPPER=change-me-dev-password-pepper-at-least-32-characters

# Seed users
APP_SEED_ENABLED=true
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=Admin123!
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_GUEST_USERNAME=guest
APP_SEED_GUEST_PASSWORD=Guest123!
APP_SEED_GUEST_EMAIL=guest@example.com

# Upload limits
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=20MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=25MB

# Logging
DEV_LOG_LEVEL=DEBUG

# SonarQube local database
SONARQUBE_DB_PASSWORD=sonarqube

# Frontend quality runner
QUALITY_RUNNER_PORT=9102
QUALITY_FRONTEND_BASE_URL=http://frontend:5173
QUALITY_RUNNER_INTERVAL_SECONDS=900
QUALITY_ROUTE_TIMEOUT_MS=30000
QUALITY_ROUTES=/,/projects,/login,/signup,/__quality_not_found__
QUALITY_LIGHTHOUSE_ROUTES=/,/projects,/login,/signup
QUALITY_LIGHTHOUSE_ENABLED=true
QUALITY_AXE_ENABLED=true
