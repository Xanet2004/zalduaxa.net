SPRING_PROFILES_ACTIVE=prod

# JWT config
APP_JWT_EXPIRATION_MS=86400000

# Production database config
DB_URL=jdbc:postgresql://postgres:5432/zalduaxa_net
DB_USERNAME=app

# Storage
STORAGE_PATH=file:/app/storage/

# CORS
APP_CORS_ORIGIN=https://zalduaxa.net

# Auth cookie
APP_AUTH_COOKIE_NAME=token
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAMESITE=Lax
APP_AUTH_COOKIE_DOMAIN=
APP_AUTH_COOKIE_PATH=/
APP_AUTH_COOKIE_MAX_AGE_DAYS=1

# Seed users disabled in production
APP_SEED_ENABLED=false
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_GUEST_USERNAME=guest
APP_SEED_GUEST_EMAIL=guest@example.com

# Upload limits
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=20MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=25MB

# Logging
PROD_LOG_LEVEL=WARN